{
  "name": "@koshko/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Validated browser-independent bridge protocol for Koshko capture data.",
  "keywords": ["koshko", "bridge", "browser-extension", "mcp"],
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --external @koshko/protocol",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@koshko/protocol": "^0.1.0"
  }
}
