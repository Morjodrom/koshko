{
  "name": "@koshko/emitter",
  "version": "0.1.0",
  "type": "module",
  "description": "Page-side signal emitter for Koshko Inspector.",
  "keywords": [
    "koshko",
    "emitter",
    "browser-extension",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Morjodrom/koshko.git",
    "directory": "packages/emitter"
  },
  "homepage": "https://github.com/Morjodrom/koshko#readme",
  "bugs": {
    "url": "https://github.com/Morjodrom/koshko/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --external @koshko/protocol",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@koshko/protocol": "^0.1.0"
  }
}
