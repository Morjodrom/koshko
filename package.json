{
  "name": "koshko-inspector-prototype",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev:extension": "npm run dev --workspace=@koshko/extension",
    "dev:demo": "npm run dev --workspace=@koshko/neutral-demo",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.289",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@wxt-dev/module-react": "1.0.0",
    "happy-dom": "^20.14.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wxt": "^0.19.20"
  }
}
