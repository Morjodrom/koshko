{
  "name": "koshko-devtools-prototype",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev:extension": "npm run dev --workspace=@koshko/extension",
    "dev:demo": "npm run dev --workspace=@koshko/neutral-demo",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.289",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.14.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue": "^3.5.13",
    "wxt": "^0.19.20"
  }
}
